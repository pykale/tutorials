{
  "$defs": {
    "Dataset": {
      "additionalProperties": false,
      "description": "A dataset a tutorial can run against.",
      "properties": {
        "auto_download": {
          "default": false,
          "description": "True if the tutorial fetches it unattended.",
          "title": "Auto Download",
          "type": "boolean"
        },
        "name": {
          "description": "Human-readable dataset name, e.g. 'CIFAR-10'.",
          "title": "Name",
          "type": "string"
        },
        "size": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Approximate download size, e.g. '170 MB'.",
          "title": "Size"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Where to obtain it.",
          "title": "Url"
        }
      },
      "required": [
        "name"
      ],
      "title": "Dataset",
      "type": "object"
    },
    "Difficulty": {
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ],
      "title": "Difficulty",
      "type": "string"
    },
    "Domain": {
      "description": "Top-level bucket. Fixed by the folder path, restated in metadata for the exporter.",
      "enum": [
        "others",
        "protein",
        "cancer",
        "cardiac",
        "materials"
      ],
      "title": "Domain",
      "type": "string"
    },
    "Fusion": {
      "description": "How multiple modalities are combined. ``none`` for single-modality tutorials.",
      "enum": [
        "none",
        "early",
        "late",
        "intermediate",
        "tensor",
        "graph"
      ],
      "title": "Fusion",
      "type": "string"
    },
    "Hardware": {
      "enum": [
        "cpu",
        "gpu_optional",
        "gpu_required"
      ],
      "title": "Hardware",
      "type": "string"
    },
    "Modality": {
      "enum": [
        "image",
        "video",
        "audio",
        "graph",
        "tabular",
        "sequence",
        "omics",
        "neuroimaging"
      ],
      "title": "Modality",
      "type": "string"
    }
  },
  "$id": "https://pykale.github.io/tutorials/schemas/tutorial.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Generated by scripts/generate_schema.py -- do not edit by hand.",
  "properties": {
    "binder": {
      "default": false,
      "description": "Offer a Binder badge.",
      "title": "Binder",
      "type": "boolean"
    },
    "colab": {
      "default": true,
      "description": "Offer a Colab badge.",
      "title": "Colab",
      "type": "boolean"
    },
    "dataset": {
      "items": {
        "$ref": "#/$defs/Dataset"
      },
      "title": "Dataset",
      "type": "array"
    },
    "difficulty": {
      "$ref": "#/$defs/Difficulty"
    },
    "domain": {
      "$ref": "#/$defs/Domain"
    },
    "draft": {
      "default": true,
      "description": "True while plot_<slug>.py is still a stub; the example itself is runnable regardless.",
      "title": "Draft",
      "type": "boolean"
    },
    "entry_point": {
      "default": "main.py",
      "title": "Entry Point",
      "type": "string"
    },
    "estimated_runtime": {
      "description": "Wall-clock estimate on the stated hardware, e.g. '~5 min'.",
      "title": "Estimated Runtime",
      "type": "string"
    },
    "fusion": {
      "$ref": "#/$defs/Fusion",
      "default": "none"
    },
    "hardware": {
      "$ref": "#/$defs/Hardware",
      "default": "cpu"
    },
    "kale_api": {
      "description": "`kale` modules the tutorial exercises.",
      "items": {
        "type": "string"
      },
      "title": "Kale Api",
      "type": "array"
    },
    "method": {
      "description": "Algorithms demonstrated, e.g. ['DANN', 'CDAN'].",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Method",
      "type": "array"
    },
    "modality": {
      "items": {
        "$ref": "#/$defs/Modality"
      },
      "minItems": 1,
      "title": "Modality",
      "type": "array"
    },
    "references": {
      "description": "Paper or repository URLs.",
      "items": {
        "type": "string"
      },
      "title": "References",
      "type": "array"
    },
    "run_command": {
      "description": "Copy-pasteable command that runs the tutorial.",
      "title": "Run Command",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "slug": {
      "description": "Folder name; must match the directory on disk.",
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Slug",
      "type": "string"
    },
    "source_example": {
      "description": "Originating folder in pykale/examples, for provenance.",
      "title": "Source Example",
      "type": "string"
    },
    "summary": {
      "description": "One or two sentences for the gallery card.",
      "maxLength": 400,
      "minLength": 20,
      "title": "Summary",
      "type": "string"
    },
    "task": {
      "description": "What the tutorial does, e.g. 'image classification'.",
      "title": "Task",
      "type": "string"
    },
    "title": {
      "description": "Gallery title. Sentence case, no trailing period.",
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "title",
    "slug",
    "summary",
    "domain",
    "task",
    "modality",
    "method",
    "difficulty",
    "source_example",
    "run_command",
    "estimated_runtime"
  ],
  "title": "PyKale tutorial metadata",
  "type": "object"
}
